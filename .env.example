# Copy this file to .env and fill in the values.
# .env is ignored by git. Exported shell variables take precedence over it.

# Authentication: use API keys, an OAuth service account, or an existing token.
# Atlas API key from Organization Access Manager.
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=

# OAuth 2.0 service account credentials (Organization Access Manager > Service Accounts).
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=

# Or an OAuth bearer token obtained from your login flow.
# Tokens entered at the prompt are kept in memory only.
ATLAS_ACCESS_TOKEN=

# Optional: used when the corresponding command argument is omitted.
# ATLAS_PROJECT_ID is the 24-hexadecimal project ID.
# ATLAS_CLUSTER_NAME accepts a cluster name or a 24-hexadecimal cluster ID.
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=

# Optional: connection string type for the index command.
# Example values: standard, standard_srv, private, private_srv, private_endpoint.
ATLAS_CONN_TYPE=

# Optional: use an existing database user instead of creating a temporary one.
# Both must be set (or both omitted). A password with special characters is
# safer in .env than on the command line.
ATLAS_DB_USERNAME=
ATLAS_DB_PASSWORD=
