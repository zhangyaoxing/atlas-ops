# Copy this file to .env and fill in the values.
# .env is ignored by git. Exported shell variables take precedence over it.

# Atlas API key from Organization Access Manager (Organization > Access Manager > API Keys).
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=

# Optional: used when the corresponding command argument is omitted.
# ATLAS_PROJECT_ID is the 24-hexadecimal project ID.
# ATLAS_CLUSTER_NAME accepts a cluster name or a 24-hexadecimal cluster ID.
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=

# Optional: use an existing database user instead of creating a temporary one.
# Both must be set (or both omitted). A password with special characters is
# safer in .env than on the command line.
ATLAS_DB_USERNAME=
ATLAS_DB_PASSWORD=
